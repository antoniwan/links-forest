---
import { Font } from 'astro:assets';
import Analytics from '@vercel/analytics/astro';
import { userConfig } from '../config/settings.loader';
import { generateMetaConfig } from '../config/meta.config';
import { PageShell } from '../components/PageShell';
import { dataLogger } from '../utils/logger';
import type { ThemeName } from '../data/theme.types';
import '../styles/global.css';

const { profile, theme, links, secondaryLinks, social } = userConfig;
const configuredTheme = theme.active;
const meta = generateMetaConfig(profile, Astro.url.pathname);
const showThemePreview = import.meta.env.DEV;

type ThemeFontVariable =
  | '--astro-font-tech'
  | '--astro-font-mono'
  | '--astro-font-wolf'
  | '--astro-font-mystic'
  | '--astro-font-sans'
  | '--astro-font-editorial'
  | '--astro-font-soft'
  | '--astro-font-garamond'
  | '--astro-font-outfit'
  | '--astro-font-literata';

const themeFontVariables: Record<ThemeName, ThemeFontVariable[]> = {
  builder: ['--astro-font-tech', '--astro-font-mono'],
  forge: ['--astro-font-tech', '--astro-font-mono'],
  wolf: ['--astro-font-wolf'],
  mystic: ['--astro-font-mystic'],
  dragon: ['--astro-font-sans'],
  warrior: ['--astro-font-sans'],
  healer: ['--astro-font-soft'],
  monk: ['--astro-font-soft'],
  artist: ['--astro-font-editorial'],
  poet: ['--astro-font-editorial'],
  alchemist: ['--astro-font-garamond'],
  strategist: ['--astro-font-outfit'],
  steward: ['--astro-font-literata'],
};

const configuredFonts = themeFontVariables[configuredTheme];
const fontsToLoad = showThemePreview
  ? [...new Set(Object.values(themeFontVariables).flat())]
  : configuredFonts;

dataLogger('Layout initialized with theme:', configuredTheme);
---

<!doctype html>
<html lang={meta.seo.language}>
  <head>
    <meta charset={meta.seo.charset} />
    <meta name="viewport" content={meta.mobile.viewport} />
    <title>{meta.openGraph.title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={meta.seo.canonical} />

    {
      fontsToLoad.map((cssVariable) => (
        <Font cssVariable={cssVariable} preload={configuredFonts.includes(cssVariable)} />
      ))
    }

    <!-- SEO Meta Tags -->
    <meta name="description" content={meta.seo.description} />
    <meta name="author" content={meta.seo.author} />
    <meta name="keywords" content={meta.seo.keywords.join(', ')} />
    <meta name="robots" content={meta.seo.robots} />
    <meta name="language" content={meta.seo.language} />
    <meta name="generator" content={meta.seo.generator} />

    <!-- OpenGraph Meta Tags -->
    <meta property="og:title" content={meta.openGraph.title} />
    <meta property="og:description" content={meta.openGraph.description} />
    <meta property="og:type" content={meta.openGraph.type} />
    <meta property="og:image" content={meta.openGraph.image} />
    <meta property="og:image:secure_url" content={meta.openGraph.image} />
    <meta property="og:image:alt" content={meta.twitter.imageAlt} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={meta.openGraph.imageWidth.toString()} />
    <meta property="og:image:height" content={meta.openGraph.imageHeight.toString()} />
    <meta property="og:url" content={meta.openGraph.url} />
    <meta property="og:site_name" content={meta.openGraph.siteName} />
    <meta property="og:locale" content={meta.openGraph.locale} />
    {
      meta.openGraph.profileFirstName && (
        <meta property="profile:first_name" content={meta.openGraph.profileFirstName} />
      )
    }
    {
      meta.openGraph.profileLastName && (
        <meta property="profile:last_name" content={meta.openGraph.profileLastName} />
      )
    }
    {
      meta.openGraph.profileUsername && (
        <meta property="profile:username" content={meta.openGraph.profileUsername} />
      )
    }
    {meta.openGraph.seeAlso.map((url) => <meta property="og:see_also" content={url} />)}

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content={meta.twitter.card} />
    <meta name="twitter:title" content={meta.twitter.title} />
    <meta name="twitter:description" content={meta.twitter.description} />
    <meta name="twitter:image" content={meta.twitter.image} />
    <meta name="twitter:image:alt" content={meta.twitter.imageAlt} />
    <meta name="twitter:creator" content={meta.twitter.creator} />
    <meta name="twitter:site" content={meta.twitter.site} />

    <!-- Mobile/App Meta Tags -->
    <meta name="theme-color" content={meta.mobile.themeColor} />
    <meta name="mobile-web-app-capable" content={meta.mobile.webAppCapable ? 'yes' : 'no'} />
    <meta
      name="apple-mobile-web-app-capable"
      content={meta.mobile.appleWebAppCapable ? 'yes' : 'no'}
    />
    <meta
      name="apple-mobile-web-app-status-bar-style"
      content={meta.mobile.appleWebAppStatusBarStyle}
    />
    <meta name="apple-mobile-web-app-title" content={meta.mobile.appleWebAppTitle} />
    <meta name="format-detection" content={meta.mobile.formatDetection} />

    <!-- Structured Data -->
    <script is:inline type="application/ld+json" set:html={JSON.stringify(meta.structuredData)} />

    {import.meta.env.PROD && <Analytics />}
  </head>
  <body class="min-h-screen antialiased">
    <PageShell
      client:load
      profile={profile}
      links={links}
      secondaryLinks={secondaryLinks}
      social={social}
      configuredTheme={configuredTheme}
      showThemePreview={showThemePreview}
    />

    <script>
      if (import.meta.env.PROD) {
        if ('serviceWorker' in navigator) {
          window.addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js').catch(() => {});
          });
        }
      } else if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then((registrations) => {
          for (const registration of registrations) {
            void registration.unregister();
          }
        });
        if ('caches' in window) {
          caches.keys().then((keys) => Promise.all(keys.map((key) => caches.delete(key))));
        }
      }
    </script>
  </body>
</html>
