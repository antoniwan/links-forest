{
  "name": "links-forest",
  "type": "module",
  "version": "3.8.0",
  "description": "A minimalist, themed link-sharing platform powered by Astro, Tailwind, and Framer Motion",
  "repository": {
    "type": "git",
    "url": "https://github.com/antoniwan/links-forest.git"
  },
  "homepage": "https://links-forest-phi.vercel.app",
  "bugs": {
    "url": "https://github.com/antoniwan/links-forest/issues"
  },
  "keywords": [
    "astro",
    "linktree",
    "personal-links",
    "portfolio",
    "themes",
    "tailwind",
    "framer-motion"
  ],
  "author": "antoniwan (Antonio Rodriguez Martinez)",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx,astro}\"",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier \"**/*.{js,jsx,ts,tsx,astro,css,scss,md,mdx,json,yml,yaml,html}\" --write"
  },
  "dependencies": {
    "@astrojs/react": "6.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@vercel/analytics": "^1.6.1",
    "astro": "^7.2.4",
    "framer-motion": "^12.23.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/debug": "^4.1.13",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "debug": "^4.4.3",
    "eslint": "^9.39.3",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
